[Unit]
Description=Weedz authenticated review API
[Service]
WorkingDirectory=%h/.local/share/weedz/site/current
ExecStart=%h/.local/share/weedz/site/current/.venv/bin/python scripts/serve_review_site.py --data %h/.local/share/weedz/site/data --port 8058 --segmentation-default sam2.1-tiny-v1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=default.target
