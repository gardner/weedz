[Unit]
Description=Weedz review and annotation Cloudflare Tunnel
After=network-online.target
[Service]
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate run --token-file %h/.config/weedz/cloudflare/site-tunnel-token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=default.target
